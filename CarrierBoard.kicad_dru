(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.2032mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.2032mm))
)
(rule "Physical clearance 1"
	(constraint physical_clearance (min 0.254mm))
)
(rule "Courtyard clearance 1"
	(constraint courtyard_clearance (min 0.254mm))
)
(rule "Power 15mil"
	(constraint connection_width (min 0.381mm))
	(condition "A.NetName == '+5V'")
)
