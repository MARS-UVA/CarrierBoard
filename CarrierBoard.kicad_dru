(version 1)
(rule "8 mil clearance"
	(constraint clearance (min 0.2032mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.2032mm))
)
(rule "Hole to hole distance"
	(constraint hole_to_hole (min 0.2032mm))
)
(rule "Via style"
	(constraint via_diameter (min 0.635mm) (max 6.4008mm))
	(constraint hole_size (min 0.3556mm) (max 6.4008mm))
)
(rule "Routing width 1"
	(constraint track_width (min 0.2032mm) (opt 0.2032mm) (max 0.2032mm))
	(condition "A.NetName == '/CAN_P' || A.NetName == '/CAN_N'")
)
(rule "Minimum text height and thickness 1"
	(constraint text_height (min 0.762mm))
	(constraint text_thickness (min 0.127mm))
)
