(version 1)
(rule "8 mil clearance"
	(constraint clearance (min 0.2032mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.2032mm))
)
(rule "Power 15mil"
	(constraint connection_width (min 0.381mm))
	(condition "A.NetName == '+5V'")
)
(rule "Hole to hole distance"
	(constraint hole_to_hole (min 0.2032mm))
)
(rule "Via style"
	(constraint via_diameter (min 0.635mm) (max 1.27mm))
	(constraint hole_size (min 0.3556mm) (max 0.7112mm))
)
